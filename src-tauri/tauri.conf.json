{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CC3",
  "version": "1.0.0",
  "identifier": "com.areorgb.cc3",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:5173",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "title": "CC3",
        "label": "main",
        "width": 1200,
        "height": 800,
        "decorations": false,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "backgroundColor": "#06090e"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": []
  }
}
